# Gemini API Key (from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Models (adjust if needed for your Gemini API tier)
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_VEO_MODEL=veo-3.1-fast-generate-001
USE_VEO=true
USE_VERTEXAI_VEO=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Content Defaults
DEFAULT_NICHE=Mind-Blowing Facts, Psychology & History
DEFAULT_FORMAT=shorts
VISUAL_STYLE=retro_cartoon
TTS_VOICE=en-US-AndrewMultilingualNeural

# Google Drive & YouTube
GOOGLE_CLIENT_SECRETS=client_secrets.json
GOOGLE_TOKEN_FILE=token.json
GOOGLE_DRIVE_FOLDER_NAME=YouTube Automation Videos
GOOGLE_DRIVE_FOLDER_ID=
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CATEGORY_ID=27

